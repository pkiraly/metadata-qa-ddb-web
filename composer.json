{
  "name": "pkiraly/metadata-qa-ddb-web",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "post-install-cmd": [
      "mkdir -p logs || true",
      "chmod g+w logs || true",
      "# you may need to execute <comment>sudo chgrp www-data logs</comment>"
    ]
  },
  "scripts-descriptions": {
    "post-install-cmd": "Runs commands after installation"
  },
  "repositories": [
  ],
  "require": {
    "psr/log": "^3.0",
    "smarty/smarty": "^4.5",
    "dompdf/dompdf": "^3.1",
    "monolog/monolog": "^3.",
    "ext-sqlite3": "*"
  },
  "require-dev": {
    "doctrine/instantiator": "1.5.0",
    "phpunit/phpunit": "~9.6",
    "phpstan/phpstan": "^1.11",
    "tomasvotruba/unused-public": "^0.3.9",
    "phpstan/extension-installer": "^1.3",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "": [ "classes/" ]
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
